{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "StudyItemAutomation": {
    "AcademicTimeZoneId": "America/Argentina/Buenos_Aires",
    "IntervalHours": 6
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Resend": {
    "FromName": "StudyFlow"
  },
  "Jwt": {
    "Issuer": "StudyFlow.Api",
    "Audience": "StudyFlow.Client",
    "ExpirationMinutes": 60
  },
  "AllowedHosts": "*"
}
